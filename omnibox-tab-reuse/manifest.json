{
  "manifest_version": 3,
  "name": "已有标签定位",
  "version": "1.2.0",
  "description": "地址栏导航放行；其他导航命中相同网址时，切换并刷新已有标签。支持启停和定位通知。",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "webNavigation",
    "storage",
    "notifications"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "已有标签定位",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "incognito": "not_allowed"
}
